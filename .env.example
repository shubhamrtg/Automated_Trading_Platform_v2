# Automated Trading Platform - Environment Configuration Template
# DO NOT store real production secrets in this file. Demo credentials only.

APP_NAME="Automated Trading Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# SQLite Database in WAL mode
DATABASE_URL="sqlite+aiosqlite:///./data/trading_platform.db"

# Local Engine Control IPC Secret (shared between API Gateway and Engine Control on 127.0.0.1)
ENGINE_CONTROL_SECRET="demo-engine-control-secret-replace-in-env"

# Account Settings
DEFAULT_ACCOUNT_CURRENCY="USD"

# AI Service (Google Gemini - paid tier recommended)
GEMINI_API_KEY="demo-gemini-key"
GEMINI_MODEL="gemini-2.5-pro"

# Secondary Alert Channels (Phase 9)
TELEGRAM_BOT_TOKEN="demo-bot-token"
TELEGRAM_CHAT_ID="demo-chat-id"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="alerts@example.com"
SMTP_PASSWORD="demo-password"
ALERT_EMAIL_RECIPIENT="owner@example.com"
HEALTHCHECKS_URL="https://hc-ping.com/demo-uuid"
